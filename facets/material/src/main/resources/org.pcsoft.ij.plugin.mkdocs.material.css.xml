<!-- Loaded only where the CSS plugin is present, which is what `loading="optional"` on the <content> entry in
     plugin.xml says. Everything in here registers against the CSS language, which does not exist without that
     plugin — and the plugin has to keep working in an IDE shipping no CSS support. -->
<idea-plugin package="org.pcsoft.ij.plugin.mkdocs.material.css">
    <dependencies>
        <plugin id="com.intellij.css"/>
        <module name="org.pcsoft.ij.plugin.mkdocs.material"/>
    </dependencies>

    <resource-bundle>messages.MkDocsMaterialBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Completes the custom properties the theme styles itself with. A site is restyled by redefining
             them in an additional style sheet, and which ones exist is documented rather than discoverable. -->
        <completion.contributor
                language="CSS"
                implementationClass="org.pcsoft.ij.plugin.mkdocs.material.css.MkDocsMaterialCssVariableCompletionContributor"/>
    </extensions>
</idea-plugin>
