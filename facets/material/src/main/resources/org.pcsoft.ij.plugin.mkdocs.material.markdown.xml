<!-- Loaded only where the Markdown plugin is present, which is what `loading="optional"` on the <content>
     entry in plugin.xml says. Everything in here registers against the Markdown language, which does not
     exist without that plugin — and the plugin has to keep working in an IDE shipping no Markdown support. -->
<idea-plugin package="org.pcsoft.ij.plugin.mkdocs.material.markdown">
    <dependencies>
        <plugin id="org.intellij.plugins.markdown"/>
        <module name="org.pcsoft.ij.plugin.mkdocs.material"/>
    </dependencies>

    <resource-bundle>messages.MkDocsMaterialBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Completes the icon shorthands of the theme, :material-check: and its like, inside the pages of a
             detected site. The names follow from the installed icon sets, so they come from the same index
             the completion in mkdocs.yml uses. -->
        <completion.contributor
                language="Markdown"
                implementationClass="org.pcsoft.ij.plugin.mkdocs.material.markdown.MkDocsMaterialShorthandCompletionContributor"/>
    </extensions>
</idea-plugin>
