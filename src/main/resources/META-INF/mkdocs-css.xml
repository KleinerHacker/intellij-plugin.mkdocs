<!-- Loaded only where the CSS plugin is present. Everything in here registers against its language, which
     does not exist without it — and the plugin has to keep working in an IDE that ships no CSS support, so
     this must never become a hard dependency. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Completes the custom properties the theme styles itself with. A site is restyled by redefining
             them in an additional style sheet, and which ones exist is documented rather than discoverable. -->
        <completion.contributor
                language="CSS"
                implementationClass="org.pcsoft.ij.plugin.mkdocs.material.css.MkDocsMaterialCssVariableCompletionContributor"/>
    </extensions>
</idea-plugin>
