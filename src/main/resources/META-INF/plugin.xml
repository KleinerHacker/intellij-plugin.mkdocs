<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <!-- Note: the Plugin Verifier rejects an ID containing the word "intellij" (TemplateWordInPluginId),
         hence "ij" — same convention as the inno-setup plugin. -->
    <id>org.pcsoft.ij.plugin.mkdocs</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Mkdocs</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/KleinerHacker">PCSoft</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Support for <a href="https://www.mkdocs.org">MkDocs</a> projects in all IntelliJ-platform IDEs.<br>
        <br>
        Documentation: <a href="https://kleinerhacker.github.io/intellij-plugin.mkdocs/">kleinerhacker.github.io/intellij-plugin.mkdocs</a>
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <!-- No dependency on org.jetbrains.kotlin: the plugin is *written* in Kotlin, which needs nothing but the
         platform-bundled stdlib at runtime. Declaring the Kotlin IDE plugin would make the plugin
         unloadable in Rider, CLion and GoLand, which do not ship it. -->
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>com.intellij.modules.json</depends>


    <!-- Message bundle for every user visible text. -->
    <resource-bundle>messages.MkDocsBundle</resource-bundle>

    <!-- Extension points offered to other plugins and to later parts of this one. -->
    <extensionPoints>
        <!-- Optional features of an MkDocs site, offered in the creation wizard. Nothing implements this
             yet — the point exists so the planned MkDocs extensions (Angular Material, I18N, Mike) can be
             added without touching the wizard. -->
        <extensionPoint name="siteFeature"
                        interface="org.pcsoft.ij.plugin.mkdocs.types.MkDocsSiteFeature"
                        dynamic="true"/>
    </extensionPoints>

    <!-- Actions contributed by the plugin. -->
    <actions>
        <!-- NewGroup backs both the "New" context menu of the project view and File | New. -->
        <action id="org.pcsoft.ij.plugin.mkdocs.CreateSite"
                class="org.pcsoft.ij.plugin.mkdocs.module.create.MkDocsCreateSiteAction"
                icon="org.pcsoft.ij.plugin.mkdocs.MkDocsIcons.MkDocs">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
    </actions>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- The MkDocs module system: the directory above an mkdocs.yml becomes an MkDocs module, which is
             represented by this facet. Optional MkDocs features are meant to be added later as facets
             declaring "mkdocs" as their underlying facet type. -->
        <facetType implementation="org.pcsoft.ij.plugin.mkdocs.module.facet.MkDocsFacetType"/>

        <!-- Initial detection when a project is opened … -->
        <postStartupActivity implementation="org.pcsoft.ij.plugin.mkdocs.module.MkDocsStartupActivity"/>
        <!-- … and re-detection after every relevant virtual file system change. -->
        <vfs.asyncListener implementation="org.pcsoft.ij.plugin.mkdocs.module.MkDocsVfsListener"/>

        <!-- Shows the site name behind the site root directory in the project view and badges its icon. -->
        <projectViewNodeDecorator implementation="org.pcsoft.ij.plugin.mkdocs.module.MkDocsProjectViewDecorator"/>

        <!-- Gives mkdocs.yml / mkdocs.yaml its own icon instead of the generic YAML one. -->
        <fileIconProvider implementation="org.pcsoft.ij.plugin.mkdocs.module.MkDocsFileIconProvider"/>

        <!-- Colors of the plugin's own text attributes, for light and for dark themes. -->
        <additionalTextAttributes scheme="Default" file="colorSchemes/MkDocsDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/MkDocsDarcula.xml"/>
    </extensions>
</idea-plugin>
