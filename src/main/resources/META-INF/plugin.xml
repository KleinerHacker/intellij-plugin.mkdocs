<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>org.pcsoft.ij.plugin.mkdocs</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Mkdocs</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/KleinerHacker">PCSoft</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Support for <a href="https://www.mkdocs.org">MkDocs</a> projects in all IntelliJ-platform IDEs.<br>
        <br>
        The plugin recognizes every MkDocs site inside your project, makes it visible in the IDE and lets you
        create new sites without leaving the editor.<br>
        <br>
        <b>Features</b>
        <ul>
            <li><b>Automatic site detection</b> &ndash; every <code>mkdocs.yml</code> / <code>mkdocs.yaml</code>
                turns its directory into an MkDocs site, re-detected after every file system change.</li>
            <li><b>Module integration</b> &ndash; a detected site is represented by an <i>MkDocs</i> facet on the
                surrounding module; if the site belongs to no module, an own module is created. Its name is taken
                from <code>site_name</code>, falling back to the directory name.</li>
            <li><b>Project view</b> &ndash; the site root is labelled with the site name and badged, and the
                documentation directory (<code>docs_dir</code>) as well as the assets directory are marked.</li>
            <li><b>File icons</b> &ndash; own icons for <code>mkdocs.yml</code> / <code>mkdocs.yaml</code> and for
                the Markdown pages below <code>docs_dir</code>.</li>
            <li><b>Site creation</b> &ndash; <i>New &rarr; MkDocs Site</i> walks through layout
                (<code>docs_dir</code>, assets, <code>site_dir</code>), site metadata (<code>site_name</code>,
                <code>site_author</code>, <code>site_description</code>, <code>site_url</code>), repository
                (<code>repo_name</code>, <code>repo_url</code>), <code>copyright</code> and optional features,
                and writes the configuration, the documentation directory and a start page.</li>
            <li><b>Repository detection</b> &ndash; repository address, repository name and author are prefilled
                from Git, and an entry deviating from the local repository is reported.</li>
            <li><b>Copyright integration</b> &ndash; the notice is taken from the IDE's Copyright profiles, with a
                choice when several are configured and no default is set.</li>
            <li><b>Metadata banner</b> &ndash; a missing <code>site_name</code>, <code>site_author</code> or
                <code>site_description</code> is reported by a banner above <code>mkdocs.yml</code> /
                <code>mkdocs.yaml</code>, each with a fix adding the key.</li>
            <li><b>JSON schema</b> &ndash; <code>mkdocs.yaml</code> is mapped to the MkDocs schema, which the
                bundled catalogue only offers for <code>mkdocs.yml</code>.</li>
            <li><b>Directory completion</b> &ndash; missing site directories are suggested in the
                <i>New Directory</i> dialog.</li>
            <li><b>Feature extension point</b> &ndash; <code>siteFeature</code> allows optional MkDocs extensions
                (Angular Material, I18N, Mike) to plug into the creation wizard.</li>
        </ul>
        The current implementation status is tracked in
        <a href="https://github.com/KleinerHacker/intellij-plugin.mkdocs/blob/master/STATUS.md">STATUS.md</a>.<br>
        <br>
        Documentation: <a href="https://kleinerhacker.github.io/intellij-plugin.mkdocs/">kleinerhacker.github.io/intellij-plugin.mkdocs</a>
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <!-- No dependency on org.jetbrains.kotlin: the plugin is *written* in Kotlin, which needs nothing but the
         platform-bundled stdlib at runtime. Declaring the Kotlin IDE plugin would make the plugin
         unloadable in Rider, CLion and GoLand, which do not ship it. -->
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>com.intellij.modules.json</depends>

    <!-- Optional: both plugins are bundled with every JetBrains IDE, but the user may switch them off. The
         prefilling they enable is a convenience, never a requirement — so everything touching them lives in a
         descriptor of its own that is simply not loaded when the plugin is missing. -->
    <depends optional="true" config-file="mkdocs-git.xml">Git4Idea</depends>
    <depends optional="true" config-file="mkdocs-copyright.xml">com.intellij.copyright</depends>

    <!-- Message bundle for every user visible text. -->
    <resource-bundle>messages.MkDocsBundle</resource-bundle>

    <!-- Extension points offered to other plugins and to later parts of this one. -->
    <extensionPoints>
        <!-- Optional features of an MkDocs site, offered in the creation wizard. Nothing implements this
             yet — the point exists so the planned MkDocs extensions (Angular Material, I18N, Mike) can be
             added without touching the wizard. -->
        <extensionPoint name="siteFeature"
                        interface="org.pcsoft.ij.plugin.mkdocs.types.MkDocsSiteFeature"
                        dynamic="true"/>

        <!-- Reads remote and user from the version control system. Implemented per VCS, because neither is
             part of the generic VCS API of the platform. -->
        <extensionPoint name="scmProvider"
                        interface="org.pcsoft.ij.plugin.mkdocs.types.MkDocsScmProvider"
                        dynamic="true"/>

        <!-- Reads the copyright notices configured in the IDE. -->
        <extensionPoint name="copyrightProvider"
                        interface="org.pcsoft.ij.plugin.mkdocs.types.MkDocsCopyrightProvider"
                        dynamic="true"/>
    </extensionPoints>

    <!-- Actions contributed by the plugin. -->
    <actions>
        <!-- NewGroup backs both the "New" context menu of the project view and File | New. -->
        <action id="org.pcsoft.ij.plugin.mkdocs.CreateSite"
                class="org.pcsoft.ij.plugin.mkdocs.module.create.MkDocsCreateSiteAction"
                icon="org.pcsoft.ij.plugin.mkdocs.MkDocsIcons.MkDocs">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
    </actions>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- The MkDocs module system: the directory above an mkdocs.yml becomes an MkDocs module, which is
             represented by this facet. Optional MkDocs features are meant to be added later as facets
             declaring "mkdocs" as their underlying facet type. -->
        <facetType implementation="org.pcsoft.ij.plugin.mkdocs.module.facet.MkDocsFacetType"/>

        <!-- Initial detection when a project is opened … -->
        <postStartupActivity implementation="org.pcsoft.ij.plugin.mkdocs.module.MkDocsStartupActivity"/>
        <!-- … and re-detection after every relevant virtual file system change. -->
        <vfs.asyncListener implementation="org.pcsoft.ij.plugin.mkdocs.module.MkDocsVfsListener"/>

        <!-- Shows the site name behind the site root directory in the project view and badges its icon. -->
        <projectViewNodeDecorator implementation="org.pcsoft.ij.plugin.mkdocs.module.MkDocsProjectViewDecorator"/>

        <!-- Gives mkdocs.yml / mkdocs.yaml and the Markdown pages of a site their own icons. -->
        <fileIconProvider implementation="org.pcsoft.ij.plugin.mkdocs.module.MkDocsFileIconProvider"/>

        <!-- Suggests the missing documentation and assets directory in the New Directory dialog. -->
        <createDirectoryCompletionContributor
                implementation="org.pcsoft.ij.plugin.mkdocs.module.MkDocsDirectoryCompletionContributor"/>

        <!-- Banner above a configuration file missing its metadata keys. A file level annotation rather than
             a highlight: what is reported is precisely what is not in the file, so there is nothing in the
             text to underline. -->
        <annotator language="yaml"
                   implementationClass="org.pcsoft.ij.plugin.mkdocs.inspection.MkDocsMissingMetadataAnnotator"/>

        <!-- Colors of the plugin's own text attributes, for light and for dark themes. -->
        <additionalTextAttributes scheme="Default" file="colorSchemes/MkDocsDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/MkDocsDarcula.xml"/>
    </extensions>

    <!-- Maps mkdocs.yaml to the MkDocs JSON schema. The bundled SchemaStore catalogue matches mkdocs.yml
         only, so the second spelling MkDocs accepts would otherwise stay without completion. -->
    <extensions defaultExtensionNs="JavaScript.JsonSchema">
        <ProviderFactory implementation="org.pcsoft.ij.plugin.mkdocs.schema.MkDocsSchemaProviderFactory"/>
    </extensions>
</idea-plugin>
