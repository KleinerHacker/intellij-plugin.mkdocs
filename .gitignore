.gradle
.idea
.intellijPlatform
.kotlin
# IDE module descriptors. Modules come from the Gradle import (external storage),
# so a *.iml inside the project is always a stale leftover with an empty classpath.
*.iml
# Gradle build output. The trailing-slash pattern matches any directory named "build",
# so re-include a `build` Kotlin *source package* should one ever live under src/.
build/
!**/src/**/build/
docs/site
docs/docs/dokka
docs/docs/licences
# Local plugin signing material (private key must never be committed)
/.signing
